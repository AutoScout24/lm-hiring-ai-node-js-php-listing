# ============================================================================
# LeasingMarkt - Port Configuration
# ============================================================================
#
# This file defines the ports used by all services in the application.
# Copy this file to .env and customize the ports as needed.
#
# Usage:
#   cp .env.example .env
#   # Edit .env to set your desired ports
#   make run
#
# ============================================================================

# Backend Service (PHP/Laravel)
# Default: 80 (HTTP)
# The port where the backend API will be accessible
BACKEND_PORT=80

# Database Service (MariaDB)
# Default: 3306 (MySQL/MariaDB standard port)
# The port where the database will be accessible
DB_PORT=3306

# Frontend Service (Next.js)
# Default: 3000 (Next.js standard port)
# The port where the frontend dev server will be accessible
FE_PORT=3000
